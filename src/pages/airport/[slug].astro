---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQBlock from '../../components/FAQBlock.astro';
import { ACTIVE_AIRPORTS, type Airport } from '../../data/airports';
import { formatVerificationClaim } from '../../utils/claims';

export function getStaticPaths() {
  return ACTIVE_AIRPORTS.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport }
  }));
}

interface Props {
  airport: Airport;
}

const { airport } = Astro.props;

// Format prices
const monthlyPrice = airport.lowestDirectMonthlyPriceCny !== null
  ? `¥${airport.lowestDirectMonthlyPriceCny.toFixed(2)} / 月起`
  : '未提供常规月付';

const annualPrice = airport.lowestListedAnnualPriceCny !== null
  ? `¥${airport.lowestListedAnnualPriceCny.toFixed(2)} / 年起`
  : '未提供年付数据';

const oneTimePrice = airport.lowestListedOneTimePriceCny !== null
  ? `¥${airport.lowestListedOneTimePriceCny.toFixed(2)} / 一次性`
  : '未提供一次性流量包';

// Dynamic FAQ generation strictly based on verified fields (FAQ-09)
const dynamicFAQs = [
  {
    question: `${airport.serviceName} 的最低入门套餐价格是多少？`,
    answer: airport.lowestDirectMonthlyPriceCny !== null
      ? `根据公开服务商资料，${airport.serviceName} 的周期订阅起步价格约为 ¥${airport.lowestDirectMonthlyPriceCny.toFixed(2)}/月。建议首次购买的用户优先选择单月档位进行测试。`
      : `目前公开资料中暂未明确列出标准的单月直接购买价格，可能主要以长期周期包或不限时套餐为主。`,
    intent: 'cost',
    keyword: '最低套餐价格'
  },
  {
    question: `${airport.serviceName} 采用什么线路架构？支持哪些客户端？`,
    answer: `${airport.serviceName} 官方资料标明的线路架构为【${airport.lineArchitecture || '公开资料未明确注明'}】。支持的客户端与平台包括：${airport.clientSupport || airport.platforms || '官方公开资料未特别列明具体客户端'}。`,
    intent: 'compatibility',
    keyword: '线路与客户端'
  },
  {
    question: `${airport.serviceName} 是否有明确的在线设备数量限制？`,
    answer: airport.deviceOrUsageLimits
      ? `官方资料载明的设备限制情况为：“${airport.deviceOrUsageLimits}”。实际使用时应避免同一账号在过多异地 IP 同时并发。`
      : `目前收录的公开资料中未特别载明限制在线设备的数量，具体规则以服务商用户中心实时规定为准。`,
    intent: 'definition',
    keyword: '设备限制'
  },
  {
    question: `购买 ${airport.serviceName} 服务前有哪些建议与风险提示？`,
    answer: `由于跨境网络连通性极大取决于用户本地网络运营商与地理位置，且绝大多数网络加速服务商不支持无理由退款，强烈建议新手用户坚持按月付费，并在晚高峰实际验证连通质量。`,
    intent: 'risk',
    keyword: '选购风险提示'
  }
];

// Related alternatives (independent reference, ZERO COMPARE)
const otherAirports = ACTIVE_AIRPORTS
  .filter((a) => a.slug !== airport.slug)
  .slice(0, 3);
const isTiziyun = airport.slug === 'tiziyun';
const pageTitle = isTiziyun 
  ? `梯子云 机场资料档案与官网入口：价格、套餐、线路与协议` 
  : `${airport.serviceName} 机场资料档案：价格、套餐、线路与协议`;

const pageDesc = isTiziyun
  ? `收录 梯子云 (LadderCloud) 官方公开参数与官网入口：最低资费、线路规格（${airport.lineArchitecture || '专线中转'}）、适配协议与套餐明细。提供客观技术事实核验与新手防坑指南。`
  : `收录 ${airport.serviceName} 官方公开参数：最低资费、线路类型（${airport.lineArchitecture || '详见档案'}）、适配协议与套餐明细。提供客观技术事实核验与新手防坑指南。`;

const pageKeywords = isTiziyun
  ? '梯子云,梯子云官网,梯子云机场,机场梯子,性价比机场,机场节点'
  : `${airport.serviceName},机场资料,机场节点,机场订阅`;
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  breadcrumbs={[
    { name: '首页', url: '/' },
    { name: '机场档案库', url: '/airports/' },
    { name: airport.serviceName, url: `/airport/${airport.slug}/` }
  ]}
>
  <div class="gazette-container py-8 sm:py-12">
    <!-- Dossier Header Block -->
    <article class="border-b-4 border-[#1a1816] pb-8 mb-10">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center space-x-2">
          <span class="px-2 py-0.5 bg-[#1a1816] text-white text-xs font-mono font-bold">DOSSIER</span>
          <span class="text-xs font-mono text-[#78716c]">编号: {airport.slug.toUpperCase()}</span>
          <span class="text-xs font-mono px-2 py-0.5 bg-stone-200 text-stone-700">
            {airport.verificationLevel === 'service_claim' ? '服务商公开声明' : '核验记录'}
          </span>
        </div>

        <div class="text-xs font-mono text-[#78716c]">
          <span>收录源文件: {airport.sourceFile}</span>
        </div>
      </div>

      <!-- Sole primary H1 for this page (HG-08) -->
      <h1 class="text-2xl sm:text-4xl font-extrabold font-serif text-[#1a1816] leading-tight mb-4">
        {airport.serviceName} 机场资料档案：价格、套餐与线路协议参数
      </h1>

      {airport.aliases && (
        <p class="text-sm font-mono text-stone-500 mb-3">
          别名与常见称谓：{airport.aliases}
        </p>
      )}

      <div class="text-base text-[#44403c] font-serif leading-relaxed bg-[#efece4]/40 p-4 border-l-4 border-[#b45309]">
        <div class="text-[11px] font-mono font-bold text-[#b45309] uppercase tracking-wider mb-1">
          服务商公开资料摘要 · SERVICE CLAIM
        </div>
        <p class="m-0">
          {formatVerificationClaim(airport.summary, airport.verificationLevel, '载明')}
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={`/go/${airport.slug}/`}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          class="px-5 py-2.5 bg-[#b45309] hover:bg-[#92400e] text-white font-serif font-bold text-sm transition-colors shadow-sm inline-flex items-center gap-2"
        >
          <span>访问服务商官网 / 查看实时套餐</span>
          <span class="font-mono">↗</span>
        </a>

        <a
          href="/airports/"
          class="px-4 py-2.5 bg-white border border-[#d6d1c7] text-[#1a1816] hover:border-[#1a1816] text-sm font-serif font-bold transition-colors"
        >
          &larr; 返回全量档案库
        </a>
      </div>
    </article>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      <!-- Main Column: Technical Specs & Plan Ledger (8 Cols) -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Section 1: Specifications Ledger -->
        <section class="border border-[#d6d1c7] bg-white p-6 shadow-gazette">
          <div class="border-b-2 border-[#1a1816] pb-2 mb-4 flex items-center justify-between">
            <h2 class="text-lg font-bold font-serif text-[#1a1816] m-0">
              公开技术参数与规格明细台账
            </h2>
            <span class="text-xs font-mono text-[#78716c]">FACT LEDGER</span>
          </div>

          <div class="divide-y divide-stone-200 text-xs sm:text-sm font-sans">
            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">物理线路架构</span>
              <span class="text-stone-900 font-mono sm:w-2/3">{airport.lineArchitecture || '官方资料未提供具体线路分类'}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">支持传输协议</span>
              <span class="text-stone-900 font-mono sm:w-2/3">{airport.protocols || '未明确载明支持协议'}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">起步周期月付</span>
              <span class="text-stone-900 font-mono font-bold sm:w-2/3 text-[#b45309]">{monthlyPrice}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">入门年付资费</span>
              <span class="text-stone-900 font-mono sm:w-2/3">{annualPrice}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">买断制不限时包</span>
              <span class="text-stone-900 font-mono sm:w-2/3">{oneTimePrice}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">客户端与支持平台</span>
              <span class="text-stone-900 sm:w-2/3">{airport.clientSupport || airport.platforms || '资料未特别注明支持客户端'}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">设备与连接限制</span>
              <span class="text-stone-900 sm:w-2/3">{airport.deviceOrUsageLimits || '未特别载明设备上限'}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">结算币种与支付渠道</span>
              <span class="text-stone-900 sm:w-2/3">{airport.currency} {airport.paymentMethods ? `(${airport.paymentMethods})` : ''}</span>
            </div>

            <div class="py-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <span class="font-serif font-bold text-stone-600 sm:w-1/3">流媒体 / AI 工具提及</span>
              <span class="text-stone-900 sm:w-2/3">
                {airport.streamingServicesMentioned || airport.aiServicesMentioned
                  ? `${airport.streamingServicesMentioned || ''} ${airport.aiServicesMentioned ? ' / ' + airport.aiServicesMentioned : ''}`
                  : '资料中未记录特殊流媒体提及'}
              </span>
            </div>
          </div>
        </section>

        <!-- Section 2: Detailed Plans Table -->
        {airport.plans && airport.plans.length > 0 && (
          <section class="border border-[#d6d1c7] bg-white p-6 shadow-gazette">
            <div class="border-b-2 border-[#1a1816] pb-2 mb-4 flex items-center justify-between">
              <h2 class="text-lg font-bold font-serif text-[#1a1816] m-0">
                服务商公开套餐方案明细
              </h2>
              <span class="text-xs font-mono text-[#78716c]">PLANS SPECIFICATION</span>
            </div>

            <div class="space-y-6">
              {airport.plans.map((sec, secIdx) => (
                <div>
                  {sec.section && (
                    <h3 class="font-serif font-bold text-sm text-[#b45309] mb-2 pb-1 border-b border-stone-200">
                      {sec.section}
                    </h3>
                  )}
                  {sec.rows && sec.rows.length > 0 && (
                    <div class="overflow-x-auto">
                      <table class="w-full text-xs font-sans border-collapse border border-[#d6d1c7]">
                        <thead>
                          <tr class="bg-[#efece4] text-stone-800 font-serif">
                            {Object.keys(sec.rows[0]).map((th) => (
                              <th class="border border-[#d6d1c7] px-2.5 py-1.5 text-left font-bold">
                                {th}
                              </th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {sec.rows.map((row, rIdx) => {
                            // Skip markdown alignment placeholder rows like :---
                            const isHeaderDivider = Object.values(row).some(v => v.includes(':---') || v.includes(':-:'));
                            if (isHeaderDivider) return null;
                            return (
                              <tr class={rIdx % 2 === 0 ? 'bg-white' : 'bg-[#fbfaf8]'}>
                                {Object.values(row).map((val) => (
                                  <td class="border border-[#d6d1c7] px-2.5 py-2 text-stone-800">
                                    {val}
                                  </td>
                                ))}
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Section 3: Advantages & Known Limitations (Both required, Rule 52) -->
        <section class="border border-[#d6d1c7] bg-white p-6 shadow-gazette">
          <div class="border-b-2 border-[#1a1816] pb-2 mb-4">
            <h2 class="text-lg font-bold font-serif text-[#1a1816] m-0">
              综合特性分析与客观限制考量
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm font-sans">
            <!-- Advantages -->
            <div class="border-l-4 border-l-[#15803d] bg-stone-50 p-4">
              <h3 class="font-serif font-bold text-sm text-[#15803d] mb-2">
                服务商公开资料特性
              </h3>
              <ul class="space-y-1.5 text-stone-700 list-disc pl-4">
                <li>线路规格（服务商标称）：{airport.lineArchitecture || '公开资料未特别列明'}。</li>
                <li>资费灵活性（公开标价）：提供多梯度套餐选项，入门起步标价在 {monthlyPrice}。</li>
                <li>客户端适配（公开声明）：{airport.clientSupport || '资料载明适配主流客户端通用订阅'}。</li>
              </ul>
            </div>

            <!-- Limitations -->
            <div class="border-l-4 border-l-[#b45309] bg-stone-50 p-4">
              <h3 class="font-serif font-bold text-sm text-[#b45309] mb-2">
                已知限制与选购注意事项
              </h3>
              <ul class="space-y-1.5 text-stone-700 list-disc pl-4">
                <li>网络质量依赖：实际延迟与连通性受本地运营商网络、物理链路及晚高峰负载影响，非本站担保。</li>
                <li>退款限制：大多数网络加速服务不支持无理由退款，强烈建议优先选择单月小额试用。</li>
                <li>单方资料属性：本页规格与功能描述均源自服务商单方公开资料，本站未开展独立测速担保。</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Dynamic FAQ Section -->
        <FAQBlock faqs={dynamicFAQs} title={`${airport.serviceName} 常见事实答问录`} />
      </div>

      <!-- Right Column: Verification Stamp & Other Providers (4 Cols) -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Bureau Audit Card -->
        <div class="border-2 border-[#1a1816] bg-[#efece4] p-5 shadow-gazette">
          <div class="border-b border-[#d6d1c7] pb-2 mb-3">
            <span class="font-serif font-bold text-sm text-[#1a1816] block">
              档案核验状态说明
            </span>
          </div>

          <div class="space-y-3 text-xs text-stone-700 font-sans">
            <p class="m-0 leading-relaxed">
              <strong>资料性质：</strong>本档案归属于【服务商单方声明资料 (Service Claim)】。
            </p>
            <p class="m-0 leading-relaxed">
              <strong>核查时间：</strong>{airport.lastCheckedAt ? airport.lastCheckedAt.split('T')[0] : '2026-09-17'} 档案初次备案。
            </p>
            <p class="m-0 leading-relaxed text-stone-500 font-mono text-[11px] bg-white p-2 border border-[#d6d1c7]">
              特别声明：本站不承诺任何第三方的网络可用性。严禁盲目大额年付充值。
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-stone-300">
            <a
              href={`/go/${airport.slug}/`}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="block w-full py-2 bg-[#1a1816] text-white hover:bg-[#b45309] text-center text-xs font-serif font-bold transition-colors"
            >
              直达服务商官方门户 ↗
            </a>
          </div>
        </div>

        <!-- Other Providers (Independent reference, STRICTLY NO COMPARE, NO VS) -->
        <div class="border border-[#d6d1c7] bg-white p-5 shadow-gazette">
          <h3 class="font-serif font-bold text-sm text-[#1a1816] pb-2 mb-3 border-b border-stone-200">
            其他可参考的服务商档案
          </h3>
          <p class="text-xs text-[#57534e] mb-3">
            以下为独立收录条目，仅供对比参考线路规格，不设横向优胜结论：
          </p>
          <div class="space-y-3">
            {otherAirports.map((other) => (
              <div class="p-2.5 border border-[#e5e0d8] bg-[#fbfaf8] hover:border-[#b45309] transition-colors">
                <div class="flex items-baseline justify-between">
                  <span class="font-serif font-bold text-xs text-[#1a1816]">
                    {other.serviceName}
                  </span>
                  <span class="text-xs font-mono text-[#b45309]">
                    {other.lowestDirectMonthlyPriceCny ? `¥${other.lowestDirectMonthlyPriceCny}/月` : '详见档案'}
                  </span>
                </div>
                <div class="text-[11px] text-stone-500 font-sans mt-1 truncate">
                  线路: {other.lineArchitecture || '公开资料未注明'}
                </div>
                <div class="mt-2 text-right">
                  <a href={`/airport/${other.slug}/`} class="text-[11px] font-serif text-[#1a1816] hover:underline font-bold">
                    查看档案 &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
